{
  "name": "blockchain-module",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "compile": "npx hardhat compile",
    "deploy:local": "npx hardhat run scripts/deploy.js --network localhost",
    "deploy:mumbai": "npx hardhat run scripts/deploy.js --network polygon_mumbai",
    "deploy:polygon": "npx hardhat run scripts/deploy.js --network polygon",
    "deploy:manual": "node deploy-contract.js",
    "node": "npx hardhat node",
    "node:persistent": "node start-persistent-node.js",
    "start:full": "npm run node:persistent",
    "test": "npx hardhat test"
  }
}
